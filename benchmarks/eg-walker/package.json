{
  "name": "eg-walker-benchmarks",
  "version": "1.0.0",
  "description": "Eg-walker benchmarks",
  "main": "./run.js",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "measure-bundle": "([ -f \"./dist/bundle.js\" ] || npm run dist) && node ../../bin/measure-bundle.js",
    "start": "npm run measure-bundle && node --expose-gc run.js && npm run table",
    "start:bun": "npm run measure-bundle && bun run run.js && npm run table",
    "start:browser": "rollup -c && 0serve -o benchmark.html",
    "table": "echo 'Eg-walker results: \n\n' && node ../../bin/render-table.js ../results.json 6000 eg-walker",
    "dist": "npm run clean && rollup -c && gzip --keep dist/*"
  },
  "author": "Kevin Jahns",
  "license": "MIT",
  "dependencies": {
    "@softmaple/eg-walker": "file:../../../softmaple/packages/eg-walker"
  }
}
